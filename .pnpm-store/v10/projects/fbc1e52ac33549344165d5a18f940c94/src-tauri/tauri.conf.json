{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Liner Music",
  "version": "0.2.23",
  "identifier": "com.iagsoftware.linermusic",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Liner",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "deb", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Music",
    "shortDescription": "Liner Music",
    "longDescription": "Liner is a music player that pulls your music and metadata from the services you already use.",
    "iOS": {
      "minimumSystemVersion": "16.5",
      "frameworks": [
        "AVFoundation",
        "MediaPlayer",
        "CoreMedia",
        "UIKit",
        "WebKit",
        "QuartzCore",
        "CoreGraphics",
        "Metal",
        "MetalKit",
        "Security",
        "AudioToolbox"
      ]
    }
  }
}
